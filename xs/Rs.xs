HUSKARL = rsArrayInt("41,555");  UNITLINE_CHAKRAM_THROWER = rsArrayInt("1741,1743");  UNITLINE_SHRIVAMSHA_RIDER = rsArrayInt("1751,1753");  UNITLINE_GHULAM = rsArrayInt("1747,1749");  UNITLINE_TARKAN = rsArrayInt("755,757");  UNITLINE_STABLE_TARKAN = rsArrayInt("886,887");  UNITLINE_CASTLE_TARKAN = rsArrayInt("755,757");  UNITLINE_KAMAYUK = rsArrayInt("879,881");  UNITLINE_GENOESE_CROSSBOWMAN = rsArrayInt("866,868");  UNITLINE_SAMURAI = rsArrayInt("291,560");  UNITLINE_IRON_PAGODA = rsArrayInt("1908,1910");  UNITLINE_LIAO_DAO = rsArrayInt("1920,1922");  UNITLINE_BALLISTA_ELEPHANT = rsArrayInt("1120,1122");  UNITLINE_WAR_WAGON = rsArrayInt("827,829");  UNITLINE_TURTLE_SHIP = rsArrayInt("831,832");  UNITLINE_LEITIS = rsArrayInt("1234,1236");  UNITLINE_MAGYAR_HUSZAR = rsArrayInt("869,871");  UNITLINE_KARAMBIT_WARRIOR = rsArrayInt("1123,1125");  UNITLINE_GBETO = rsArrayInt("1013,1015");  UNITLINE_KONA = rsArrayInt("2566,2568");  UNITLINE_BOLAS_RIDER = rsArrayInt("2569,2571");  UNITLINE_PLUMED_ARCHER = rsArrayInt("763,765");  UNITLINE_MANGUDAI = rsArrayInt("11,561");  UNITLINE_GUECHA_WARRIOR = rsArrayInt("2562,2564");  UNITLINE_TEMPLE_GUARD = rsArrayInt("2586,2587");  UNITLINE_WAR_ELEPHANT = rsArrayInt("239,558");  UNITLINE_OBUCH = rsArrayInt("1701,1703");  UNITLINE_ORGAN_GUN = rsArrayInt("1001,1003");  UNITLINE_CARAVEL = rsArrayInt("1004,1006");  UNITLINE_CENTURION = rsArrayInt("1790,1792");  UNITLINE_MAMELUKE = rsArrayInt("282,556");  UNITLINE_HEARTH_TROOP = rsArrayInt("2705,2706");  UNITLINE_WHITE_FEATHER_GUARD = rsArrayInt("1959,1961");  UNITLINE_SERJEANT = rsArrayInt("1658,1659,1660,1661");  UNITLINE_CASTLE_SERJEANT = rsArrayInt("1658,1659");  UNITLINE_DONJON_SERJEANT = rsArrayInt("1660,1661");  UNITLINE_BOYAR = rsArrayInt("876,878");  UNITLINE_CONQUISTADOR = rsArrayInt("771,773");  UNITLINE_KESHIK = rsArrayInt("1228,1230");  UNITLINE_TEUTONIC_KNIGHT = rsArrayInt("25,554");  UNITLINE_BLACKWOOD_ARCHER = rsArrayInt("2579,2581");  UNITLINE_JANISSARY = rsArrayInt("46,557");  UNITLINE_JARL = rsArrayInt("2708,2709");  UNITLINE_RATTAN_ARCHER = rsArrayInt("1129,1131");  UNITLINE_BERSERK = rsArrayInt("692,694");  UNITLINE_TIGER_CAVALRY = rsArrayInt("1949,1951");  UNITLINE_FIRE_ARCHER = rsArrayInt("1968,1970");     TECH_PLACEHOLDER_TECHNOLOGIES = rsArrayInt("968,969,970,971,972,973,974,975,976,977");  TECH_BLANK_TECHNOLOGIES = rsArrayInt("1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509"); } void rsConsole(string text = "") {  if(RS_SHOW_ERROR_LOG) {  xsChatData("<RED>" + text);  } }  int rsTotal(int array = -1) {  return(xsArrayGetSize(array)); }  bool rsTechInRange(int techId = -1) {  if(techId <= RS_MAX_TECHNOLOGY_ID && techId > 0) {  return(true);  }  rsConsole("rsTechInRange Error:\nThe number of tech ID must be between 1 and " + RS_MAX_TECHNOLOGY_ID);  return(false); }  bool rsUnitInRange(int unitId = -1) {  if(unitId <= RS_MAX_UNIT_ID && unitId > 0) {  return(true);  }  rsConsole("rsUnitInRange Error:\nThe number of unit ID must be between 1 and " + RS_MAX_UNIT_ID);  return(false); }  bool rsClassInRange(int classId = -1) {  if(classId > 899 && classId < 1000) {  return(true);  }  rsConsole("rsClassInRange Error:\nThe number of class ID must be between 900 and 999");  return(false); }  bool rsPlayerInRange(int playerId = -1) {  int getTotalPlayer = xsGetNumPlayers();  if((playerId > 0 && playerId <= getTotalPlayer) == true) {  return(true);  }  rsConsole("rsPlayerInRange Error:\nThe number of players must be between 1 and " + getTotalPlayer);  return(false); }  bool rsIsPlayer(int playerId = -1) {  int getTotalPlayer = xsGetNumPlayers();  if((playerId > -2 && playerId <= getTotalPlayer) == true) {  return(true);  }  rsConsole("rsIsPlayer Error:\nInvalid player ID: " + playerId +". The number of players must be between -1 and " + getTotalPlayer);  return(false); }  int rsGetResourceId(string resource = "food") {  resource = strToLower(resource);  int resourceId = 0;   if(resource == "food") { resourceId = cAttributeFood; }  else if (resource == "wood") { resourceId = cAttributeWood; }  else if (resource == "gold") { resourceId = cAttributeGold; }  else if(resource == "stone") { resourceId = cAttributeStone; }  else { resourceId = -1; }   return(resourceId); }  string rsGetResourceAsString(int resource = 0) {  string resourceId = "";  switch(resource) {  case 0 : { resourceId = "food"; }  case 1 : { resourceId = "wood"; }  case 2 : { resourceId = "stone"; }  case 3 : { resourceId = "gold"; }  default : { resourceId = "invalid"; }   }  return(resourceId); }  int rsGetCostOperationId(string operation = "add", string resource = "food") {  operation = strToLower(operation);  resource = strToLower(resource);  int operationId = -1;   if(operation == "add" || operation == "subtract") {  if(resource == "food") { operationId = cAttrAddFoodCost; }  else if(resource == "gold") { operationId = cAttrAddGoldCost; }  else if(resource == "stone") { operationId = cAttrAddStoneCost; }  else if(resource == "wood") { operationId = cAttrAddWoodCost; }   } else if(operation == "multiply") {  if(resource == "food") { operationId = cAttrMulFoodCost; }  else if(resource == "gold") { operationId = cAttrMulGoldCost; }  else if(resource == "stone") { operationId = cAttrMulStoneCost; }  else if(resource == "wood") { operationId = cAttrMulWoodCost; }  else if(resource == "all") { operationId = cAttrMulAllCosts; }  } else {  if(resource == "food") { operationId = cAttrSetFoodCost; }  else if(resource == "gold") { operationId = cAttrSetGoldCost; }  else if(resource == "stone") { operationId = cAttrSetStoneCost; }  else if(resource == "wood") { operationId = cAttrSetWoodCost; }  }  return(operationId); }  int rsGetResourceOperationId(int resourceField = 1, string where = "unit", string type = "resource") {  if(resourceField < 1 || resourceField > 3) { rsConsole("rsGetResourceOperationId: resourceField Error:\nThe resource ID must be between 1 and 3"); return(NULL); }   where = strToLower(where);  type = strToLower(type);  int operationId = -1;   if(where == "unit") {  if(resourceField == 2) {  if(type == "resource") { operationId = cTypeSecondCost; }  else if(type == "amount") { operationId = cAmountSecondCost; }  else if(type == "deduct") { operationId = cDeductFlagSecondCost; }  } else if(resourceField == 3) {  if(type == "resource") { operationId = cTypeThirdCost; }  else if(type == "amount") { operationId = cAmountThirdCost; }  else if(type == "deduct") { operationId = cDeductFlagThirdCost; }  } else {  if(type == "resource") { operationId = cTypeFirstCost; }  else if(type == "amount") { operationId = cAmountFirstCost; }  else if(type == "deduct") { operationId = cDeductFlagFirstCost; }  }  } else {  if(resourceField == 2) {  if(type == "resource") { operationId = cAttrTypeSecondCost; }  else if(type == "amount") { operationId = cAttrAmountSecondCost; }  else if(type == "deduct") { operationId = cAttrDeductFlagSecondCost; }  } else if(resourceField == 3) {  if(type == "resource") { operationId = cAttrTypeThirdCost; }  else if(type == "amount") { operationId = cAttrAmountThirdCost; }  else if(type == "deduct") { operationId = cAttrDeductFlagThirdCost; }  } else {  if(type == "resource") { operationId = cAttrTypeFirstCost; }  else if(type == "amount") { operationId = cAttrAmountFirstCost; }  else if(type == "deduct") { operationId = cAttrDeductFlagFirstCost; }  }  }  return(operationId); }  int rsGetUnitOperationId(string operation = "set") {  if(operation == "add" || operation == "subtract") {  return(cAddAttribute);  } else if(operation == "multiply") {  return(cMulAttribute);  }  return(cSetAttribute); } int rsGetTechStateId(string techState = "") {  techState = strToLower(techState);  int stateId = cTechStateInvalid;   if(techState == "disabled") { stateId = cTechStateDisabled; }  else if(techState == "notready") { stateId = cTechStateNotReady; }  else if(techState == "ready") { stateId = cTechStateReady; }  else if(techState == "inprogress") { stateId = cTechStateResearching; }  else if(techState == "done") { stateId = cTechStateDone; }  else if(techState == "queued") { stateId = cTechStateQueued; }  else { stateId = cTechStateInvalid; }   return(stateId); }  string rsGetTechStateAsString(int techState = 0) {  string stateId = "invalid";  switch(techState) {  case -1 : { stateId = "disabled"; }  case 0 : { stateId = "notReady"; }  case 1 : { stateId = "ready"; }  case 2 : { stateId = "inProgress"; }  case 3 : { stateId = "done"; }  case 4 : { stateId = "queued"; }  default : { stateId = "invalid"; }   }  return(stateId); }  float rsMath(string operation = "set", float value1 = 0, float value2 = 0) {  if(operation == "add") {  return(value1 + value2);  } else if(operation == "subtract") {  return(value1 - value2);  } else if(operation == "multiply") {  return(value1 * value2);  }  return(value2); }  void rsEffect(int playerId = -1, int unitTechObjectId = -1, int effectId = -1, int attributeOrOperation = -1, float value = -1, int locationEntry = -1) {  xsEffectAmount(effectId, unitTechObjectId, attributeOrOperation, value, playerId, locationEntry); }  int rsTechModifyAttr(int playerId = -1, int techId = -1, int attribute = -1, float value = 0, int locationEntry = NULL) {  rsEffect(playerId, techId, cModifyTech, attribute, value, locationEntry);  return(techId); }  int rsTechEnable(int playerId = -1, int techId = -1, bool enabled = true) {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  if(enabled) {  rsTechModifyAttr(playerId, techId, cAttrSetState, cAttributeEnable);  } else {  rsTechModifyAttr(playerId, techId, cAttrSetState, cAttributeDisable);  }  }  return(techId); }  int rsTechSetMetadata(int playerId = -1, int techId = -1, int nameId = NULL, int descriptionId = NULL, int iconId = NULL) {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  if(nameId != NULL) { rsTechModifyAttr(playerId, techId, cAttrSetName, nameId); }  if(descriptionId != NULL) { rsTechModifyAttr(playerId, techId, cAttrSetDescription, descriptionId); }  if(iconId != NULL) { rsTechModifyAttr(playerId, techId, cAttrSetIcon, iconId); }  }  return(techId); }  int rsTechSetLocation(int playerId = -1, int techId = -1, int buildingId = NULL, int buttonId = NULL, int trainTime = NULL, int hotkeyId = NULL, int trainLocationIndex = 0) {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  if(buildingId != NULL) { rsTechModifyAttr(playerId, techId, cAttrSetLocation, buildingId, trainLocationIndex); }  if(buttonId != NULL) { rsTechModifyAttr(playerId, techId, cAttrSetButton, buttonId, trainLocationIndex); }  if(trainTime != NULL) { rsTechModifyAttr(playerId, techId, cAttrSetTime, trainTime, trainLocationIndex); }  if(hotkeyId != NULL) { rsTechModifyAttr(playerId, techId, cAttrSetHotkey, hotkeyId, trainLocationIndex); }  }  return(techId); }  int rsTechModifyBaseCost(int playerId = -1, int techId = -1, string operation = "set", string costType = "food", float amount = 0) {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  int operationId = rsGetCostOperationId(operation, costType);  if(operation == "subtract") {  amount = 0 - amount;  }  rsTechModifyAttr(playerId, techId, operationId, amount);  }  return(techId); }  int rsTechModifyTime(int playerId = -1, int techId = -1, string operation = "add", float value = 0) {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  int getEntryLength = xsGetTechAttribute(playerId, techId, cTechNumResearchLocations);  float result = value;  for(i = 0; < getEntryLength) {  int getResearchTime = xsGetTechAttribute(playerId, techId, cTechResearchTime, i);  if(operation == "subtract") {  result = getResearchTime - value;  } else if(operation == "add") {  result = getResearchTime + value;  } else if(operation == "multiply") {  result = getResearchTime * value;  }  rsTechModifyAttr(playerId, techId, cAttrSetTime, result, i);  }  }  return(techId); }  int rsTechSetResourceCost(int playerId = -1, int techId = -1, int resourceIndex = -1, string resourceName = "food", float amounts = 0, int deductFlag = 1) {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  rsTechModifyAttr(playerId, techId, rsGetResourceOperationId(resourceIndex, "tech", "resource"), rsGetResourceId(resourceName));  rsTechModifyAttr(playerId, techId, rsGetResourceOperationId(resourceIndex, "tech", "amount"), amounts);  rsTechModifyAttr(playerId, techId, rsGetResourceOperationId(resourceIndex, "tech", "deduct"), deductFlag);  }  return(techId); }  int rsTechSetResourceCostType(int playerId = -1, int techId = -1, int resourceIndex = -1, string resourceName = "food") {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  rsTechModifyAttr(playerId, techId, rsGetResourceOperationId(resourceIndex, "tech", "resource"), rsGetResourceId(resourceName));  }  return(techId); }  int rsTechSetResourceCostAmount(int playerId = -1, int techId = -1, int resourceIndex = -1, float amounts = 0) {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  rsTechModifyAttr(playerId, techId, rsGetResourceOperationId(resourceIndex, "tech", "amount"), amounts);  }  return(techId); }  int rsTechSetResourceCostDeduct(int playerId = -1, int techId = -1, int resourceIndex = -1, int deductFlag = 1) {  if(rsTechInRange(techId) && rsPlayerInRange(playerId)) {  rsTechModifyAttr(playerId, techId, rsGetResourceOperationId(resourceIndex, "tech", "deduct"), deductFlag);  }  return(techId); } int rsObjectEnable(int playerId = -1, int objectId = -1, bool enabled = true) {  if(rsPlayerInRange(playerId) && rsUnitInRange(objectId)) {  if(enabled) {  rsEffect(playerId, objectId, cEnableObject, cAttributeEnable, 1);  } else {  rsEffect(playerId, objectId, cEnableObject, cAttributeDisable, 0);  }  }  return(objectId); }  int rsObjectSetMetadata(int playerId = -1, int objectId = -1, int nameId = NULL, int descriptionId = NULL, int iconId = NULL) {  if(rsIsPlayer(playerId) && rsUnitInRange(objectId)) {  if(nameId != NULL) { rsEffect(playerId, objectId, cSetAttribute, cNameId, nameId); }  if(descriptionId != NULL) { rsEffect(playerId, objectId, cSetAttribute, cDescriptionId, descriptionId); }  if(iconId != NULL) { rsEffect(playerId, objectId, cSetAttribute, cIconId, iconId); }  }  return(objectId); }  int rsObjectSetLocation(int playerId = -1, int objectId = -1, int buildingId = -1, int buttonId = NULL, float trainTime = NULL, int hotkeyId = NULL, int locationIndex = NULL) {  if(rsPlayerInRange(playerId) && rsUnitInRange(objectId) && rsUnitInRange(buildingId)) {  int index = 0;  if(locationIndex != NULL) {  int totalEntry = xsGetUnitAttribute(objectId, cTrainLocationsTotalNum);  if((locationIndex + 1) > totalEntry) {  rsEffect(playerId, objectId, cMulAttribute, cTrainLocationsEntryMod, 32767);  } else {  index = locationIndex;  }  }  rsEffect(playerId, objectId, cSetAttribute, cTrainLocation, buildingId, index);  if(buttonId != NULL) { rsEffect(playerId, objectId, cSetAttribute, cTrainButton, buttonId, index); }  if(trainTime != NULL) { rsEffect(playerId, objectId, cSetAttribute, cTrainTime, trainTime, index); }  if(hotkeyId != NULL) { rsEffect(playerId, objectId, cSetAttribute, cHotkeyId, hotkeyId, index); }  }  return(objectId); }  int rsObjectModifyTime(int playerId = -1, int objectId = -1, string operation = "set", float value = 0) {  if(rsPlayerInRange(playerId) && rsUnitInRange(objectId)) {  int totalEntry = xsGetObjectAttribute(playerId, objectId, cTrainLocationsTotalNum);  int operationId = rsGetUnitOperationId(operation);  float result = value;   if(operation == "subtract") {  result = 0 - value;  }    for(index = 0; < totalEntry) {  rsEffect(playerId, objectId, operationId, cTrainTime, result, index);  }  }  return(objectId); }  int rsObjectModifyProperty(int playerId = -1, int objectId = -1, int property = -1, string operation = "set", float value = 0) {  if(rsPlayerInRange(playerId) && rsUnitInRange(objectId)) {  int getProperty = xsGetObjectAttribute(playerId, objectId, property);  float result = rsMath(operation, getProperty, value);   rsEffect(playerId, objectId, cSetAttribute, property, result);  }  return(objectId); }  int rsObjectModifyPropertyByClass(int playerId = -1, int classId = -1, int property = -1, string operation = "", float value = 0) {  if(rsPlayerInRange(playerId) && rsClassInRange(classId)) {  int operationId = rsGetUnitOperationId(operation);  float result = value;   if(operation == "subtract") {  result = 0 - value;  }    rsEffect(playerId, classId, operationId, property, result);  }  return(classId); }  int rsAddAttackClass(int playerId = -1, int unitId = -1, int damageClass = -1) {  if(rsPlayerInRange(playerId) && rsUnitInRange(unitId)) {  rsEffect(playerId, unitId, cSetAttribute, cAddAttackType, damageClass);  }  return(unitId); }  int rsRemoveAttackClass(int playerId = -1, int unitId = -1, int damageClass = -1) {  if(rsPlayerInRange(playerId) && rsUnitInRange(unitId)) {  rsEffect(playerId, unitId, cSetAttribute, cRemoveAttackType, damageClass);  }  return(unitId); }  int rsAddArmorClass(int playerId = -1, int unitId = -1, int damageClass = -1) {  if(rsPlayerInRange(playerId) && rsUnitInRange(unitId)) {  rsEffect(playerId, unitId, cSetAttribute, cAddArmorType, damageClass);  }  return(unitId); }  int rsRemoveArmorClass(int playerId = -1, int unitId = -1, int damageClass = -1) {  if(rsPlayerInRange(playerId) && rsUnitInRange(unitId)) {  rsEffect(playerId, unitId, cSetAttribute, cRemoveArmorType, damageClass);  }  return(unitId); }  int rsObjectModifyAttack(int playerId = -1, int unitId = -1, string operation = "set", int damageClass = -1, float value = 0, bool setDisplay = false) {  if(rsPlayerInRange(playerId) && rsUnitInRange(unitId)) {  int magicNumber = 256 * damageClass;  float result = magicNumber + value;  int operationId = cSetAttribute;   if(operation == "add") {  operationId = cAddAttribute;  result = magicNumber + value;  } else i