ayerDb);   if(getSize < 1) { return; }   for(item = 0; < getSize) {  int getItems = rsArrayIntGet(getPlayerDb, item);  ___RS_API_TECHNOLOGY_CONDITIONS___(getItems, player);   }  } }  bool rsTechnologyInspectAdd(int playerId = -1, int techId = -1, int params = NULL) {  return(___RS_API_TECHNOLOGY_SET___(playerId, techId, params)); }  void rsTechnologyInspectAddAll(int techId = -1, int params = NULL) {  for(i = 0; < 8) {  ___RS_API_TECHNOLOGY_SET___(i + 1, techId, params);  } }  bool rsTechnologyInspectRemove(int playerId = -1, int techId = -1) {  return(___RS_API_TECHNOLOGY_REMOVE___(playerId, techId)); }  void rsTechnologyInspectRemoveAll(int techId = -1) {  for(i = 0; < 8) {  ___RS_API_TECHNOLOGY_REMOVE___(i + 1, techId);  } }  int tick = 0; rule ___RS_SYSTEM_LISTENER___  inactive  group rsTechEvent  highFrequency  priority 1 {  int time = xsGetWorldTime();  if(tick < time) {  tick = xsGetWorldTime() + RS_EVENT_DELAY;        ___RS_API_TIMER_INSPECTOR___();  ___RS_API_TECHNOLOGY_INSPECTOR___();   if(RS_INTERACTIVITY == false) {  xsDisableSelf();  }  }   } void main() {  ___RS_CONSTANTS_DEFINE_OBJECTS_TECHS___();  RsReady();   for(player = 1; <= xsGetNumPlayers()) {  int getCivilizationId = xsGetPlayerCivilization(player);  string currentAge = "Dark";  int ageNumber = 0;   if(xsGetTechState(103, player) == cTechStateDone) {  if(xsGetTechState(636, player) == cTechStateDone) {  currentAge = "Post-Imperial";  ageNumber = 4;  } else {  currentAge = "Imperial";  ageNumber = 3;  }  } else if(xsGetTechState(102, player) == cTechStateDone) {  currentAge = "Castle";  ageNumber = 2;  } else if(xsGetTechState(101, player) == cTechStateDone) {  currentAge = "Feudal";  ageNumber = 1;  }  RsPlayer(player, getCivilizationId, currentAge, ageNumber);  }    if(RS_INTERACTIVITY) {    rsTechnologyInspectAddAll(101);  rsTechnologyInspectAddAll(102);  rsTechnologyInspectAddAll(103);  for(blankTechs = 0; < xsArrayGetSize(TECH_BLANK_TECHNOLOGIES)) {  rsTechnologyInspectAddAll(rsArrayIntGet(TECH_BLANK_TECHNOLOGIES, blankTechs));  }  xsEnableRule("___RS_SYSTEM_LISTENER___");  }  } 
